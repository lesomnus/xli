	local lbuf=""
	[[ -n ${curr} ]] && lbuf=${LBUFFER[-${#curr},-1]}

	# The trigger tag and separator below mirror internal/comp (TagPrefix+"zsh"
	# and Sep); keep them in sync with that package.
	local -a lines
	lines=("${(@f)$(${words[1,CURRENT]:Q} "\$\$xli_completion_zsh" "${curr}" "${lbuf}")}")

	# Each line is one of:
	#   v<sep><group><sep><entry>   a candidate ("value" or "value:desc")
	#   f<sep><pattern>             request file completion
	#   d<sep>                      request directory completion
	typeset -A grouped
	local -a order file_globs
	local want_files=0 want_dirs=0
	local line kind rest group entry
	local sep=$'\x1f'
	for line in "${lines[@]}"; do
		[[ -z ${line} ]] && continue
		kind=${line%%${sep}*}
		rest=${line#*${sep}}
		case ${kind} in
		v)
			group=${rest%%${sep}*}
			entry=${rest#*${sep}}
			[[ -z ${entry} ]] && continue
			(( ${+grouped[$group]} )) || order+=("${group}")
