			;;
		f)
			want_files=1
			[[ -n ${rest} ]] && file_globs+=("${rest}")
			;;
		d)
			want_dirs=1
			;;
		esac
	done

	local g
	for g in "${order[@]}"; do
		local -a opts
		opts=("${(@f)${grouped[$g]%$'\n'}}")
		if [[ -n ${g} ]]; then
			_describe "${g}" opts
		else
			_describe 'values' opts
		fi
	done

	(( want_dirs )) && _files -/
	if (( want_files )); then
		if (( ${#file_globs} )); then
			local glob
			for glob in "${file_globs[@]}"; do
				_files -g "${glob}"
			done
